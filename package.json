{
  "name": "dsh-companion-example",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal DSH bundle example: host Service + Cordis event listener + client Slot badge, public plugin APIs only",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": "0.1.7-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2"
  }
}
